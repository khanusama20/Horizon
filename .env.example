# Horizon Backend Server Environment Configuration
PORT=3001
HOST=127.0.0.1

# YouTube Data API v3 Key (Server-Side Only)
# Acquire your free key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure "YouTube Data API v3" is enabled in your Google Cloud Project: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Copy this file to .env and insert your API key:
# Example: YOUTUBE_API_KEY=AIzaSy...
YOUTUBE_API_KEY=
