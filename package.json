{
  "name": "horizon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "dev:ip": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "server:local": "node server/index.js",
    "server:ip": "node server/index.js --ip",
    "dev:all": "concurrently -n \"VITE,API\" -c \"cyan,magenta\" \"vite\" \"node server/index.js\"",
    "dev:all:local": "concurrently -n \"VITE,API\" -c \"cyan,magenta\" \"vite\" \"node server/index.js\"",
    "dev:all:ip": "concurrently -n \"VITE,API\" -c \"cyan,magenta\" \"vite --host 0.0.0.0\" \"node server/index.js --ip\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase.cmd deploy --only hosting",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "vue": "^3.5.13",
    "vuetify": "^3.7.15"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "happy-dom": "^21.0.4",
    "vite": "^6.2.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.0.7"
  }
}
